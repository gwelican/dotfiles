{{- $secrets := include (joinPath .chezmoi.sourceDir "secrets.yaml.age") | decrypt | fromYaml -}}
auto_sync = true
sync_address = "{{ $secrets.atuin_base_url }}"
key_path = "~/.atuin-key"
style = "full"
inline_height = 0
common_subcommands = [
  "apt",
  "cargo",
  "composer",
  "dnf",
  "docker",
  "git",
  "go",
  "ip",
  "kubectl",
  "nix",
  "nmcli",
  "npm",
  "pecl",
  "pnpm",
  "podman",
  "port",
  "systemctl",
  "tmux",
  "yarn",
  "k",
]

[sync]
records = true

[theme]
name = "catppuccin-frappe-sapphire"

[ai]
enabled = true

[pty_proxy]
enabled = false
