{{- $secrets := include (joinPath .chezmoi.sourceDir "secrets.yaml.age") | decrypt | fromYaml -}}
{{- $th := $secrets.toolhive_base_url -}}
{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "toolhive-core": {
      "type": "http",
      "url": "{{ $th }}/core/mcp",
      "headers": {},
      "enabled": false
    },
    "toolhive-observability": {
      "type": "http",
      "url": "{{ $th }}/observability/mcp",
      "headers": {},
      "enabled": false
    },
    "toolhive-media": {
      "type": "http",
      "url": "{{ $th }}/media/mcp",
      "headers": {},
      "enabled": true
    },
    "toolhive-home": {
      "type": "http",
      "url": "{{ $th }}/home/mcp",
      "headers": {},
      "enabled": false
    },
    "toolhive-creative": {
      "type": "http",
      "url": "{{ $th }}/creative/mcp",
      "headers": {},
      "enabled": false
    },
    "toolhive-finance": {
      "type": "http",
      "url": "{{ $th }}/finance/mcp",
      "headers": {},
      "enabled": false
    },
    "toolhive-tasks": {
      "type": "http",
      "url": "{{ $th }}/tasks/mcp",
      "headers": {},
      "enabled": false
    },
    "toolhive-admin": {
      "type": "http",
      "url": "{{ $th }}/mcp",
      "headers": {},
      "enabled": false
    },
    "toolhive-remote": {
      "type": "http",
      "url": "https://{{ trimPrefix "http://" $th }}/",
      "headers": {},
      "enabled": false
    }
  }
}
