{{- $secrets := include (joinPath .chezmoi.sourceDir "secrets.yaml.age") | decrypt | fromYaml -}}
---
theme:
  dark: dark-solarized
symbolPreset: nerd
display:
  showTokenUsage: true
  cacheMissMarker: true
statusLine:
  preset: default
  showHookStatus: true
modelRoles:
  default: litellm/nexus/strata-swift15-qfn-iq2xs
  slow: llama/strata-swift15-qfn-iq2xs
  plan: llama/strata-swift15-qfn-iq2xs
  task: llama/strata-swift15-qfn-iq2xs
  advisor: openai-codex/gpt-5.4-mini
  vision: openai-codex/gpt-5.4-mini
  web: web/searxng
  smol: llama/strata-swift15-qfn-iq2xs
  tiny: llama/strata-swift15-qfn-iq2xs
searxng:
  endpoint: {{ $secrets.searxng_base_url }}
  language: en
providers:
  enabled: true
browser:
  headless: true
memories:
  enabled: true
setupVersion: 3
hideThinkingBlock: false
autolearn:
  enabled: true
task:
  showResolvedModelBadge: true
  eager: task
  maxConcurrency: 1
  agentAdvisor:
    task: "on"
compaction:
  handoffSaveToDisk: true
  methodOrder:
    - snapcompact
    - remote
    - soft
defaultThinkingLevel: auto
advisor:
  enabled: false
steeringMode: one-at-a-time
features:
  unexpectedStopDetection: smart
edit:
  mode: hashline
mcp:
  notifications: false
plan:
  defaultOnStartup: false
secrets:
  enabled: true
terminal:
  showProgress: true
tui:
  tight: false
branchSummary:
  enabled: true
bash:
  autoBackground:
    enabled: true
checkpoint:
  enabled: false
tools:
  xdev: true
  xdevDocs: catalog
vault:
  enabled: true
dev:
  autoqaConsent: granted
  autoqa: false
disabledProviders:
  - lm-studio
  - huggingface
  - ollama
  - llama.cpp
  - openai
composer:
  shape: band
security:
  enabled: true
retry:
  fallbackChains:
    web:
      - web/perplexity
      - google-gemini-cli/gemini-2.5-flash
      - google-antigravity/gemini-2.5-flash
      - google/gemini-2.5-flash
      - anthropic/claude-haiku-4-5
      - openai-codex/gpt-5.6-luna
      - xai/grok-4.5
      - web/zai
      - web/exa
      - web/tinyfish
      - web/jina
      - web/kagi
      - web/tavily
      - web/firecrawl
      - web/brave
      - web/kimi
      - web/parallel
      - web/synthetic
      - web/startpage
      - web/duckduckgo
      - web/ecosia
      - web/google
      - web/mojeek
      - web/public
      - web/hosted
update:
  auto: true
